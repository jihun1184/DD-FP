# DD-FP R7 GPU runner configuration.  Copy to config/r7.env and edit:   cp config/r7.env.example config/r7.env
# Plain KEY=VALUE (never executed by a shell). '#' starts a comment. ~ and $VARS are expanded. Unknown keys are rejected.
# (Key names keep the R3_ prefix because the unchanged R3 helper modules parse them.)  Every value can be overridden on the command line.

# ---- locations you MUST decide ----
# Directory that holds the BraTS2021 subject folders:  <R3_BRATS_ROOT>/BraTS2021_xxxxx/BraTS2021_xxxxx_flair.nii.gz   (1,251 subjects). Read-only use.
R3_BRATS_ROOT=
# Results go here (one sub-folder per run, one per attempt). Must NOT be inside this package, the data folder or a protected folder.
# Empty -> <folder containing this package>/ddfp_r7_runs
R3_OUT_ROOT=
# Folders that must never be written (e.g. existing benchmark / training result folders), comma separated.
R3_PROTECT_DIRS=

# ---- environment ----
# Python of the isolated environment (venv/conda; needs numpy, nibabel, cupy matching the server CUDA). Empty -> <R3_VENV>/bin/python if present, else python3.
R3_PYTHON=
R3_VENV=
# Sealed production checkout built OFFLINE from the bundled git bundle + frozen patch (`bash run7.sh prepare`). Empty -> <folder containing this package>/DD-FP-R7
R3_REPO=
# 'auto' = first GPU that is idle; or a physical index as shown by nvidia-smi (0, 1, ...). A busy GPU is never used.
R3_CUDA_DEVICE=auto
R3_REFERENCE_DIR=
R3_ALLOW_NON_ISOLATED_PYTHON=0

# ---- resource guards ----
R3_MIN_FREE_GPU_GIB=8
R3_MIN_DISK_GIB=15
R3_MIN_RAM_GIB=12
# a GPU counts as busy above this memory use (MiB) or utilisation (%): a running training job makes every GPU stage refuse to start
R3_IDLE_MEM_MIB=1500
R3_IDLE_UTIL_PCT=10

# ---- experiment settings (recorded in every stage_meta.json) ----
R3_COHORT_SEED=42
